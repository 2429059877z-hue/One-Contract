{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-contract/review-plan-v2.schema.json",
  "title": "One-Contract review plan v2",
  "type": "object",
  "required": [
    "meta",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "contract_name",
        "party_role",
        "edit_policy"
      ],
      "properties": {
        "contract_name": {
          "type": "string",
          "minLength": 1
        },
        "party_role": {
          "type": "string",
          "minLength": 1
        },
        "edit_policy": {
          "enum": [
            "revise-first",
            "balanced",
            "comment-first"
          ]
        },
        "primary_type_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "amount": {},
        "business_model": {},
        "business_overview": {},
        "conclusion": {},
        "confirmed_domain_code": {},
        "contract_amount": {},
        "contract_name": {},
        "contract_summary": {},
        "contract_term": {},
        "contract_type": {},
        "core_conclusion": {},
        "core_rights_obligations": {},
        "coverage_assets": {},
        "coverage_level": {},
        "deal_overview": {},
        "duration": {},
        "key_milestones": {},
        "key_recommendations": {},
        "milestones": {},
        "missing_fields": {},
        "missing_information": {},
        "obligations_overview": {},
        "opinion": {},
        "overall_opinion": {},
        "overall_risk": {},
        "overview": {},
        "parties": {},
        "party_a": {},
        "party_a_name": {},
        "party_b": {},
        "party_b_name": {},
        "party_role": {},
        "payment_arrangement": {},
        "payment_terms": {},
        "pending_items": {},
        "price_overview": {},
        "price_terms": {},
        "pricing_terms": {},
        "primary_domain_code": {},
        "primary_type_id": {},
        "review_opinion": {},
        "review_version": {},
        "rights_allocation_changes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "finding_id",
                  "original",
                  "revised",
                  "reason",
                  "alternative"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "original": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revised": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alternative": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "rights_and_obligations": {},
        "rights_obligations": {},
        "rights_obligations_summary": {},
        "risk_level": {},
        "role": {},
        "signing_date": {},
        "stub_topics": {},
        "tax_advice": {},
        "tax_notes": {},
        "tax_recommendation": {},
        "tax_recommendations": {},
        "tax_suggestion": {},
        "tax_suggestions": {},
        "term": {},
        "timeline": {},
        "title": {},
        "to_fill_items": {},
        "total_amount": {},
        "transaction_content": {},
        "transaction_profile": {},
        "version": {},
        "乙方": {},
        "待填事项": {},
        "涉税建议": {},
        "甲方": {}
      },
      "additionalProperties": false
    },
    "transaction_facts": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "properties": {
        "trigger_results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk_level",
          "evidence_state",
          "action",
          "legal_basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "evidence_state": {
            "enum": [
              "confirmed",
              "reasonable_assumption",
              "major_choice",
              "not_applicable"
            ]
          },
          "action": {
            "enum": [
              "auto",
              "comment",
              "report-only",
              "delete",
              "delete_paragraph",
              "insert",
              "replace",
              "none",
              "skip"
            ],
            "description": "delete 只删除文字；delete_paragraph 删除完整段落文字及段落标记，要求完整段落定位，复杂结构会拒绝。"
          },
          "legal_basis": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "rule_hit": {
            "type": "string",
            "description": "命中的库内明确规则（写规则所在文件与条号，如「common-clause-doctrine 3.5.2 保险安排」）。一旦填写，direction_clear 必填；且该 finding 不得记 evidence_state=major_choice——「有明确规则可依 + 方向明确」正是 1.5 所说的落笔情形，不是「该由客户决定的结构性选择」。"
          },
          "direction_clear": {
            "type": "boolean",
            "description": "改动方向是否明确。与 rule_hit 成对出现。rule_hit 非空且 direction_clear=true 时，evidence_state 只能是 confirmed 或 reasonable_assumption（不得为 major_choice）——由 validate_plan 强制校验。"
          },
          "pending_kind": {
            "enum": [
              "fill",
              "verify",
              "authorization"
            ]
          },
          "report_bucket": {
            "enum": [
              "general",
              "tax",
              "mixed"
            ]
          },
          "tax_advice": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "output_kind": {
            "type": "string",
            "minLength": 1
          },
          "trigger_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "directed_block": {
            "type": "object",
            "required": [
              "active",
              "reason",
              "scope"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "const": "this_finding"
              },
              "prohibited_actions": {
                "type": "array",
                "items": {
                  "enum": [
                    "auto",
                    "comment",
                    "report-only",
                    "delete",
                    "insert",
                    "replace",
                    "delete_paragraph"
                  ]
                },
                "uniqueItems": true
              },
              "prohibited_outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required_outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "trigger_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": true
          },
          "title": {
            "type": "string"
          },
          "clause": {
            "type": "string"
          },
          "clause_position": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "target_text": {
            "type": "string",
            "description": "接受视图中的最小充分修改区间；delete_paragraph 必须覆盖完整段落。insert 使用该文字所在段作为插入位置。"
          },
          "search": {
            "type": "string"
          },
          "replacement_text": {
            "type": "string"
          },
          "recommended_text": {
            "type": "string"
          },
          "insert_text": {
            "type": "string",
            "description": "action=insert 默认按换行生成多个真实段落并按文本顺序插入；显式 tag=w:r 的行内插入不拆段。"
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1,
            "description": "从1开始，按本条执行时接受视图中的剩余匹配计数，不是原始文档位置序号。"
          },
          "selector": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string"
              },
              "contains": {
                "type": "string"
              },
              "attrs": {
                "type": "object"
              },
              "line_number": {
                "type": [
                  "integer",
                  "array"
                ]
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1,
                "description": "从1开始，按本条执行时接受视图中的剩余匹配计数，不是原始文档位置序号。"
              }
            }
          },
          "rights_allocation_change": {
            "type": "boolean",
            "description": "改变权利归属的改文必须为 true，且 summary.rights_allocation_changes 须披露"
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "type": "array",
      "description": "对源文档既有批注的逐条回复（可选）。执行器据此在审阅件中形成线程化回复。审查人不是当事人：回复只用核对口径（现稿已体现／本轮已补充／未按该意见修改／仍需填写），不使用「采纳、同意、接受、认可」这类当事人表态。stance=already_present 时必须给出 evidence（条文号或其他落点）——没有依据不得声称现稿已覆盖，更不得把现稿本就有的内容写成本轮成果。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stance",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "description": "定位源批注：comment_id，或 anchor_text（同时匹配锚定正文与批注内容）+ occurrence。",
            "properties": {
              "comment_id": {
                "type": "integer",
                "minimum": 0
              },
              "anchor_text": {
                "type": "string",
                "minLength": 1
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "comment_id"
                ]
              },
              {
                "required": [
                  "anchor_text"
                ]
              }
            ]
          },
          "stance": {
            "enum": [
              "already_present",
              "added_this_round",
              "declined",
              "pending_fill"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "现稿已体现的依据／落点（stance=already_present 时必填）。"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_text": {
            "type": "string",
            "description": "源意见摘要（写进报告的处理表）。"
          },
          "source_author": {
            "type": "string"
          },
          "linked_clauses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "required": [
                "stance"
              ],
              "properties": {
                "stance": {
                  "const": "already_present"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "linkage_checklist": {
      "type": "object",
      "description": "条款联动必检清单（可选字段，但新审查必须登记）：五组逐组给出 checked，或 not_applicable + reason。缺整张清单不阻断执行，但会在审查意见书中报为未闭合事项。",
      "properties": {
        "payment_delivery_acceptance": {
          "$ref": "#/$defs/linkageEntry"
        },
        "change_termination_breach": {
          "$ref": "#/$defs/linkageEntry"
        },
        "confidentiality_data_ip": {
          "$ref": "#/$defs/linkageEntry"
        },
        "liability_insurance": {
          "$ref": "#/$defs/linkageEntry"
        },
        "role_and_third_party": {
          "$ref": "#/$defs/linkageEntry"
        },
        "expiry_exit_handover": {
          "$ref": "#/$defs/linkageEntry"
        }
      },
      "additionalProperties": true
    },
    "knowledge_selection": {
      "type": "object",
      "required": [
        "primary_type_id",
        "our_role",
        "scene_tags"
      ],
      "properties": {
        "primary_type_id": {
          "type": "string"
        },
        "secondary_type_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "our_role": {
          "type": "string",
          "minLength": 1
        },
        "scene_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "classification_status": {
          "type": "string"
        },
        "confirmed_domain_code": {
          "type": "string"
        }
      }
    },
    "module_checklist": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "reason",
          "finding_ids"
        ],
        "properties": {
          "status": {
            "enum": [
              "checked",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "linkageEntry": {
      "type": "object",
      "description": "一组的检查结论：checked，或 not_applicable 并写明 reason。",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "结论落点（条文号或 finding id）"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
